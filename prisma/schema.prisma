// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Barbershop {
  id                        Int              @id @default(autoincrement())
  name                      String
  city                      String
  address                   String?
  phone                     String?

  slug                      String?          @unique

  defaultDepositPercentage  Int              @default(15)
  platformFee               Int              @default(200)

  logoBase64                String?          @db.Text

  services                  Service[]
  appointments              Appointment[]
  users                     BarbershopUser[]
  barbers                   Barber[]
}

model Service {
  id              Int        @id @default(autoincrement())
  barbershopId    Int
  barbershop      Barbershop @relation(fields: [barbershopId], references: [id])

  name            String
  price           Int
  durationMinutes Int        @default(30)
  description     String?

  barbers           Barber[]
  depositPercentage Int?
  appointments      Appointment[]
}

model Appointment {
  id            Int      @id @default(autoincrement())
  barbershopId  Int
  serviceId     Int
  barberId      Int?

  customerName  String
  customerPhone String
  customerEmail String    // Obligatorio — se usa para enviar confirmación
  notes         String?

  paymentProvider     String?  @default("mercadopago")
  paymentId           String?
  realPaymentId       String?
  externalReference   String?  @unique
  lockExpiresAt       DateTime?

  date          String
  time          String

  status        String   @default("CONFIRMED")
  paymentStatus String   @default("unpaid")

  depositPercentageAtBooking Int @default(0)
  servicePrice               Int @default(0)
  depositAmount              Int @default(0)
  platformFee                Int @default(0)

  createdAt     DateTime @default(now())

  barbershop    Barbershop @relation(fields: [barbershopId], references: [id])
  service       Service    @relation(fields: [serviceId], references: [id])
  barber        Barber?    @relation(fields: [barberId], references: [id])

  @@unique([barberId, date, time])
}

model BarbershopUser {
  id           Int        @id @default(autoincrement())
  barbershopId Int
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  name         String
  email        String     @unique
  passwordHash String
  role         String     @default("owner")

  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  createdAt    DateTime   @default(now())
}

// ════════════ MÓDULO DE MIEMBROS ════════════

model Barber {
  id           Int        @id @default(autoincrement())
  barbershopId Int
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  name         String
  avatarBase64 String?    @db.Text
  role         String     @default("Barbero")
  isActive     Boolean    @default(true)
  email        String?    // Email para recibir avisos de nuevos turnos

  mpAccessToken    String?
  mpUserId         String?
  mpRefreshToken   String?
  mpTokenExpiresAt DateTime?
  mpStatus         String   @default("NOT_CONNECTED")

  services     Service[]
  appointments Appointment[]
  workingHours BarberWorkingHour[]
  blockedTimes BarberBlockedTime[]

  createdAt    DateTime   @default(now())
}

model BarberWorkingHour {
  id        Int    @id @default(autoincrement())
  barberId  Int
  barber    Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  weekday   Int
  startTime String
  endTime   String

  @@unique([barberId, weekday, startTime, endTime])
}

model BarberBlockedTime {
  id        Int     @id @default(autoincrement())
  barberId  Int
  barber    Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)

  dateFrom  String
  dateTo    String?
  startTime String?
  endTime   String?
  reason    String?
}
